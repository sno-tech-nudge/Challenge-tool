generator client {
  provider = "prisma-client-js"
}

// Postgres so it runs on Vercel (serverless has no writable disk for SQLite).
// DATABASE_URL = pooled connection used at runtime; DATABASE_URL_UNPOOLED = direct connection (the name Neon uses) used for migrations.
// With a single connection string (e.g. local Postgres) set both to the same value.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// role: ADMIN | JURY  (validated in src/lib/constants.ts)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         String
  passwordHash String
  createdAt    DateTime @default(now())

  scores       JuryScore[]
  notes        JurorNote[]
  reviewDrafts ReviewDraft[]
}

model Org {
  id   String  @id @default(cuid())
  key  String  @unique // stable slug used by the data import
  name String
  slot String? // interview slot, display text e.g. "10 Nov, 10:00-10:45" (used only when slotStart is not set)
  // the interview slot as real times. Jurors' lists follow slotStart; scoring opens at slotStart, and
  // once slotEnd has passed a submitted review can no longer be changed. null = no restriction.
  slotStart DateTime?
  slotEnd   DateTime?

  sector   String?
  location String?
  website  String?
  summary  String? // short blurb shown in lists and at the top of the page
  about    String? // long free text, whitespace preserved

  // the organisation details card: JSON of { sectionKey: Block[] } (see src/lib/orgSections.ts). null = not loaded yet.
  details String?

  // admin-written, shown read-only to jurors
  internalQueries String?
  internalSwot    String?

  // external evaluator, fed in later as data: the score is stored already out of 60 (no
  // conversion here), plus reasoning. null = not fed yet.
  ecociateScore   Float?
  ecociateRemarks String?

  // jurors' private notes and unsubmitted score drafts for this organisation
  jurorNotes   JurorNote[]
  reviewDrafts ReviewDraft[]

  // the organisation's factsheet (PDF), kept in its own table so it is never loaded with the org
  factsheet OrgFactsheet?

  // admin final call: Y | N | null (undecided)
  verdict        String?
  verdictComment String?
  verdictAt      DateTime?

  createdAt DateTime    @default(now())
  scores    JuryScore[]
}

model JuryScore {
  id              String   @id @default(cuid())
  orgId           String
  org             Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jurorId         String
  juror           User     @relation(fields: [jurorId], references: [id])
  // JSON array of { key, score, remarks } — keys come from src/lib/rubric.ts
  entries         String
  total           Float
  // the juror's own yes / no call ('Y' or 'N') and their internal remarks; null on older reviews
  verdict         String?
  internalRemarks String?
  updatedAt       DateTime @updatedAt

  @@unique([orgId, jurorId])
}

// Append-only record of who did what. actorId / orgId are plain text (no foreign keys) on purpose,
// so the history survives a member or organisation being removed; names are copied in as well.
model ActivityLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorId   String?
  actorName String
  action    String // see ACTIVITY_ACTIONS in src/lib/activity.ts
  orgId     String?
  orgName   String?
  detail    String?

  @@index([at])
}

// One PDF per organisation, stored in the database so it is only served to signed-in people
// (see src/app/api/factsheet/[id]/route.ts). Loaded by `npm run db:import-factsheets`.
model OrgFactsheet {
  orgId     String   @id
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pdf       Bytes
  updatedAt DateTime @updatedAt
}

// A juror's private notes about one organisation. Only that juror ever reads them. Removed with the
// juror or the organisation.
model JurorNote {
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jurorId   String
  juror     User     @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  text      String
  updatedAt DateTime @updatedAt

  @@id([orgId, jurorId])
}

// Scores, remarks, verdict and comment a juror has typed but not submitted, saved automatically so
// they can come back to it. JSON of { scores, remarks, verdict, comment }. Deleted on submit or clear.
model ReviewDraft {
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jurorId   String
  juror     User     @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  data      String
  updatedAt DateTime @updatedAt

  @@id([orgId, jurorId])
}
