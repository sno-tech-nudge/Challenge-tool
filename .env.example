# copy to .env — .env is git-ignored. On Vercel set the same names in Project Settings > Environment Variables.

# Postgres. DATABASE_URL = pooled connection (runtime), DIRECT_URL = direct connection (migrations/seed).
# With one plain connection string (e.g. local Postgres) put the same value in both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# signs the session cookie; any long random string (e.g. `openssl rand -hex 32`). REQUIRED in production.
AUTH_SECRET="dev-only-change-me"

# dev-only password given to every seeded account (see prisma/seed.ts). Never reuse a real password.
SEED_PASSWORD="aahaar-dev-1234"
# optional per-account overrides for the two named accounts (set in your own .env, never commit real values)
# SEED_PASSWORD_ADMIN=""
# SEED_PASSWORD_JUROR1=""
