# copy to .env — .env is git-ignored
DATABASE_URL="file:./dev.db"
# signs the session cookie; any long random string. Required in production.
AUTH_SECRET="dev-only-change-me"
# dev-only password given to every seeded account (see prisma/seed.ts). Never reuse a real password.
SEED_PASSWORD="midline-dev-1234"
# optional per-account overrides for the two named accounts (set in your own .env, never commit real values)
# SEED_PASSWORD_ADMIN=""
# SEED_PASSWORD_JUROR1=""
